# PROPOSITION (02/10/2026) — NON INSTALLÉE. Ajouter beyrouth.express au ludoc-watchdog du Mac Mini.
#
# Pourquoi : aucun moniteur ne teste beyrouth.express depuis l'extérieur. Le heartbeat Supabase
# ne passe qu'à 08:00, depuis AWS Dublin (faux « HORS LIGNE » du 02/10). Le ludoc-watchdog
# tourne déjà toutes les 5 min, 3 essais espacés de 10 s, et n'alerte qu'au CHANGEMENT
# d'état (DOWN puis rétabli) : zéro bruit, pas de nouveau démon (décision du 11/09 respectée).
#
# Ce que fait le patch :
#   - nouveau type de cible « page » : la page doit répondre 2xx/3xx ET contenir un mot-clé
#     (une page vide ou d'erreur servie en 200 serait sinon vue comme « UP ») ;
#   - nouvelle cible "Beyrouth Express|page|https://beyrouth.express/|Beyrouth".
#   Les 5 cibles Ludoc existantes ne changent pas. 1er passage : état absent = « UP »,
#   donc aucune fausse alerte à l'installation.
#   ⚠️ Les alertes partent sur le bot de ce watchdog (@CourtOuCreveBOT, chat de Ludovik),
#   pas sur le bot Beyrouth. Message : « 🔴 Beyrouth Express est DOWN (code …) ».
#
# Testé le 02/10 sur le MacBook (fonction check() isolée, contre le vrai site) :
#   check page "https://beyrouth.express/|Beyrouth"        → UP
#   check page "https://beyrouth.express/|MotInexistant"   → DOWN:200-sans-MotInexistant
#   bash -n (syntaxe) → OK
# Base du patch : /usr/local/bin/ludoc-watchdog.sh, sha256 9d8522c97946cd1a30cfe31b3a9bf13266c88372c46b351d1aaadf9844e66110
#
# INSTALLATION (sur le Mac Mini, quand Ludovik le décide) — additif et réversible à chaud,
# ne touche ni sshd, ni tailscale, ni le réseau :
#   scp ~/beyrouth/propositions/ludoc-watchdog-beyrouth.patch mac-mini:/tmp/
#   ssh mac-mini
#   shasum -a 256 /usr/local/bin/ludoc-watchdog.sh        # doit être 9d8522c9…6110, sinon STOP
#   sudo cp -p /usr/local/bin/ludoc-watchdog.sh /usr/local/bin/ludoc-watchdog.sh.bak-20261002
#   sudo patch -p1 -d / --dry-run < /tmp/ludoc-watchdog-beyrouth.patch   # doit dire « succeeded »
#   sudo patch -p1 -d / < /tmp/ludoc-watchdog-beyrouth.patch
#   sudo bash -n /usr/local/bin/ludoc-watchdog.sh && echo OK
#   sudo /usr/local/bin/ludoc-watchdog.sh; tail -3 /var/log/ludoc-watchdog.log; cat /usr/local/var/ludoc-watchdog.state
#     → l'état doit contenir « Beyrouth Express=UP » et aucune alerte ne doit partir.
#   Pas besoin de recharger launchd (run-and-exit, relu toutes les 5 min).
#
# RETOUR ARRIÈRE :
#   sudo cp -p /usr/local/bin/ludoc-watchdog.sh.bak-20261002 /usr/local/bin/ludoc-watchdog.sh
#
--- a/usr/local/bin/ludoc-watchdog.sh
+++ b/usr/local/bin/ludoc-watchdog.sh
@@ -29,6 +29,10 @@
   "Linktree|http|https://link.ludoc.net/"
   "ludoc.net|http|https://ludoc.net/"
   "Supabase (base)|supabase|${SB_URL}/rest/v1/pages?select=slug&limit=1"
+  # Beyrouth Express (Paco) — ajout proposé le 02/10/2026 : témoin EXTÉRIEUR du site,
+  # en plus du heartbeat Supabase (qui ne teste qu'à 08:00, depuis AWS Dublin).
+  # Type « page » : 2xx/3xx ne suffit pas, la page doit contenir le mot-clé (après le 2e |).
+  "Beyrouth Express|page|https://beyrouth.express/|Beyrouth"
 )
 
 # --- Test d'une cible : renvoie "UP" ou "DOWN" ---
@@ -36,7 +40,16 @@
   local type="$1" url="$2" code i
   local tries=3 gap=10
   for i in $(seq 1 "$tries"); do
-    if [ "$type" = "supabase" ]; then
+    if [ "$type" = "page" ]; then
+      # url = "adresse|mot-clé" : la page doit répondre 2xx ET contenir le mot-clé
+      # (une page d'erreur servie en 200 serait sinon vue comme « UP »).
+      local u="${url%%|*}" kw="${url#*|}" body
+      body=$(curl -s -m 15 -L -A "LdvkWatchdog/1.0" -w $'\n%{http_code}' "$u" 2>/dev/null)
+      code="${body##*$'\n'}"
+      if [ "$code" -ge 200 ] 2>/dev/null && [ "$code" -lt 400 ] 2>/dev/null; then
+        printf '%s' "$body" | grep -qF "$kw" || code="200-sans-${kw}"
+      fi
+    elif [ "$type" = "supabase" ]; then
       code=$(curl -s -o /dev/null -w "%{http_code}" -m 15 \
         -H "apikey: $SB_KEY" -H "Authorization: Bearer $SB_KEY" "$url" 2>/dev/null)
     else
